{
 "title": "ClearPath",
 "uid": "clearpath",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second by route (\"other\" = unknown paths, e.g. 404s)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(clearpath_http_requests_total[1m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p95 latency by route",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(clearpath_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Error rate (5xx share)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(clearpath_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(clearpath_http_requests_total[5m])), 1e-9)",
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Pods (autoscaler)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kube_deployment_status_replicas{namespace=\"clearpath\",deployment=\"clearpath\"}",
     "legendFormat": "replicas"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU per pod (cores)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"clearpath\",container=\"clearpath\"}[1m]))",
     "legendFormat": "{{pod}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Memory per pod",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"clearpath\",container=\"clearpath\"})",
     "legendFormat": "{{pod}}"
    }
   ]
  }
 ]
}