# Copy to .env for local runs. NEVER commit real values. In production every secret below is
# mounted from Google Secret Manager (see infra/secrets.sh), not set as a plain env var.
CP_ENV=development
# --- secrets (Secret Manager in production) ---
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
DATABASE_URL=postgresql://clearpath_app:<password>@localhost:5432/clearpath
# --- Supabase Auth (the anon key is public by design; the JWT secret is only for legacy HS256 projects) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# --- limits ---
CP_DAILY_LLM_CALL_CAP=200
CP_RATE_LIMIT_LLM=10/minute
CP_RATE_LIMIT_AUTH=5/minute
ALLOWED_HOSTS=localhost,127.0.0.1
